# SurgeGuard Backend - environment configuration
#
# Copy to `.env` and adjust. Every variable is optional; the defaults shown are
# what the application uses when a variable is absent.
#
# All variables are prefixed SURGEGUARD_ and map to fields on
# `app.core.config.Settings`.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SURGEGUARD_APP_NAME=SurgeGuard
SURGEGUARD_APP_VERSION=0.1.0
# development | demonstration | production
SURGEGUARD_ENVIRONMENT=development
SURGEGUARD_DEBUG=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SURGEGUARD_HOST=127.0.0.1
SURGEGUARD_PORT=8000
# Comma-separated. Only needed when a browser calls the API from another origin:
# the frontend's Vite dev server proxies /api and /ws, and a production build is
# served by this process, so both are same-origin already.
SURGEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for the prototype. Access is through SQLAlchemy throughout, so moving
# to PostgreSQL is a URL change plus a migration run:
#   postgresql+asyncpg://user:password@localhost:5432/surgeguard
SURGEGUARD_DATABASE_URL=sqlite+aiosqlite:///./surgeguard.db
# Logs every SQL statement. Diagnostic use only - very noisy.
SURGEGUARD_DATABASE_ECHO=false
# Run `alembic upgrade head` at startup, so a fresh deployment needs no separate step.
SURGEGUARD_DATABASE_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Operator authentication
# ---------------------------------------------------------------------------
# Every API route, video stream and the Command Center socket require a
# signed-in operator. The first visit to a deployment with no accounts goes to
# /setup to create the first administrator. Turn off only on an isolated
# demonstration machine: everyone who can reach it then acts as an administrator.
SURGEGUARD_AUTH_ENABLED=true
# How long a sign-in lasts - one control-room shift.
SURGEGUARD_SESSION_TTL_HOURS=12
SURGEGUARD_SESSION_COOKIE_NAME=surgeguard_session
# HTTPS-only cookie. Leave unset: on in production, off elsewhere (plain http on a LAN).
# SURGEGUARD_SESSION_COOKIE_SECURE=true
# Failed sign-ins allowed per address and email, and how long a lockout lasts.
# The limiter keys on the client address, so behind a reverse proxy every
# client shares one key - configure the proxy to pass the real address.
SURGEGUARD_LOGIN_MAX_FAILURES=5
SURGEGUARD_LOGIN_LOCKOUT_SECONDS=300
# PBKDF2-SHA256 iterations for new password hashes (OWASP recommendation).
SURGEGUARD_AUTH_PASSWORD_ITERATIONS=600000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
SURGEGUARD_LOG_LEVEL=INFO
# console | json
SURGEGUARD_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Real-time
# ---------------------------------------------------------------------------
# Server-side ping interval. The Command Center raises its stale-data banner
# when it has heard nothing for longer than expected.
SURGEGUARD_WS_HEARTBEAT_SECONDS=15.0

# ---------------------------------------------------------------------------
# AI Pipeline
# ---------------------------------------------------------------------------
# Target analysis rate. Not yet enforced: the pipeline processes every frame the
# source delivers, and `/api/v1/pipeline/status` reports what it actually
# achieved. Rate limiting arrives with the analysis stages that define the rate.
SURGEGUARD_ANALYSIS_FPS=10.0
SURGEGUARD_DETECTION_WIDTH=960
SURGEGUARD_DETECTION_HEIGHT=540
# auto | cpu | cuda | cuda:N
# An unavailable device falls back to CPU and reports why, rather than refusing
# to start. Check /api/v1/pipeline/status to see which device is actually in use.
SURGEGUARD_DETECTION_DEVICE=cuda
SURGEGUARD_DETECTION_CONFIDENCE_THRESHOLD=0.35
# Checkpoint name or path. Downloaded into data/models/ on first use.
SURGEGUARD_DETECTION_MODEL=yolo11s.pt
# Inference resolution in pixels. Must be a multiple of 32.
SURGEGUARD_DETECTION_IMAGE_SIZE=960

# ---------------------------------------------------------------------------
# Perception pipeline
# ---------------------------------------------------------------------------
# Whether the pipeline starts with the backend. Set false to serve the API
# without a camera or a GPU.
SURGEGUARD_PIPELINE_ENABLED=true
# LIVE reads the configured camera; DEMO replays SURGEGUARD_DEMO_VIDEO_PATH.
# This is the only setting that differs between the two modes - the pipeline
# itself is identical in both.
SURGEGUARD_PIPELINE_SOURCE_MODE=LIVE
# Recovery backoff after a camera or pipeline failure. Doubles from the first
# delay up to the maximum.
SURGEGUARD_PIPELINE_RESTART_DELAY_SECONDS=2.0
SURGEGUARD_PIPELINE_MAX_RESTART_DELAY_SECONDS=30.0
# Consecutive recovery attempts before giving up. 0 means never give up, which
# is what a control room wants: a camera unplugged for an hour should still
# recover when it returns.
SURGEGUARD_PIPELINE_MAX_RESTART_ATTEMPTS=0
# How long a person may be hidden before their tracking identity is released.
SURGEGUARD_TRACKER_LOST_TRACK_TIMEOUT_SECONDS=1.0

# ---------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------
SURGEGUARD_CAMERA_ID=cam-01
SURGEGUARD_CAMERA_NAME=Camera 01
SURGEGUARD_CAMERA_LOCATION=Platform 3

# Device index for an attached camera, or an RTSP/HTTP URL:
#   0
#   rtsp://user:password@192.168.1.50:554/stream1
#   http://<phone-ip>:4747/video          (DroidCam)
SURGEGUARD_LIVE_CAMERA_DEVICE=0
SURGEGUARD_LIVE_CAMERA_FALLBACK_FPS=30.0
# Network streams only. A read that waits longer than this is abandoned, and a
# camera whose reads keep failing for the stall period is reconnected - without
# these a phone that leaves the network blocks the pipeline in a read.
SURGEGUARD_LIVE_CAMERA_OPEN_TIMEOUT_SECONDS=5.0
SURGEGUARD_LIVE_CAMERA_READ_TIMEOUT_SECONDS=5.0
SURGEGUARD_LIVE_CAMERA_STALL_SECONDS=6.0
# GENERAL | ENTRANCE | WAITING_AREA | QUEUE | SERVICE | EXIT
SURGEGUARD_CAMERA_ROLE=GENERAL
# Physical area this camera watches. Cameras that share an area are treated as
# overlapping and their counts are never simply added. Unset = its own area.
# SURGEGUARD_CAMERA_COVERAGE_AREA=main-hall

# ---------------------------------------------------------------------------
# Additional cameras
# ---------------------------------------------------------------------------
# The camera above is camera 1, the primary camera. Declare more with indexed
# variables - only URL is required; the id and name default to cam-NN and
# "Camera NN". Fields: ID, NAME, LOCATION, URL, ENABLED, ROLE, COVERAGE_AREA,
# DEMO_VIDEO_PATH.
#
# SURGEGUARD_CAMERA_2_ID=cam-02
# SURGEGUARD_CAMERA_2_NAME=Queue Side View
# SURGEGUARD_CAMERA_2_URL=http://<second-phone-ip>:4747/video
# SURGEGUARD_CAMERA_2_ROLE=QUEUE
#
# Edits made on the Camera Network page are saved to the camera registry and
# take precedence over these values for the fields that were edited.
# SURGEGUARD_CAMERA_REGISTRY_PATH=../data/cameras.json
# SURGEGUARD_TOPOLOGY_PATH=../data/topology.json
# How often a phone's device endpoint is checked for latency and battery.
SURGEGUARD_CAMERA_HEALTH_PROBE_INTERVAL_SECONDS=10.0
# How long an operator-requested connection test reads frames for.
SURGEGUARD_CAMERA_CONNECTION_TEST_SECONDS=3.0

# ---------------------------------------------------------------------------
# Site intelligence and history
# ---------------------------------------------------------------------------
SURGEGUARD_SITE_UPDATE_INTERVAL_SECONDS=1.0
# A camera silent for longer than this is left out of site figures - and the
# site view says so - rather than its last reading being carried forward.
SURGEGUARD_SITE_MAX_OBSERVATION_AGE_SECONDS=10.0
# Aggregated observation buckets written to the database. Never frames or images.
SURGEGUARD_HISTORY_ENABLED=true
SURGEGUARD_HISTORY_BUCKET_SECONDS=30
SURGEGUARD_HISTORY_RETENTION_DAYS=30
SURGEGUARD_HISTORY_BASELINE_MIN_SAMPLES=20

# ---------------------------------------------------------------------------
# Alert hardware
# ---------------------------------------------------------------------------
# An Arduino with an RGB LED and a buzzer on USB serial, following the Decision
# Engine: green Normal, yellow Warning, red with alarm Critical, blue when no
# camera has a current report. Firmware, wiring and protocol: hardware/README.md.
SURGEGUARD_HARDWARE_ENABLED=false
# A port such as COM8 or /dev/ttyACM0, or auto for the first connected Arduino.
SURGEGUARD_HARDWARE_SERIAL_PORT=auto
SURGEGUARD_HARDWARE_BAUD_RATE=115200
# Resend the current command this often; must stay under the firmware's 10 s link timeout.
SURGEGUARD_HARDWARE_KEEPALIVE_SECONDS=3
SURGEGUARD_HARDWARE_RECONNECT_SECONDS=5

# ---------------------------------------------------------------------------
# Demonstration Mode
# ---------------------------------------------------------------------------
# The clip replayed when SURGEGUARD_PIPELINE_SOURCE_MODE=DEMO. Processed by the
# complete pipeline exactly as a live feed - nothing is scripted (Rule 7).
# SURGEGUARD_DEMO_VIDEO_PATH=../data/scenarios/00_placeholder.mp4
# Restart the clip on reaching its end. Off by default so a finished clip is
# reported as finished rather than silently replayed.
SURGEGUARD_DEMO_VIDEO_LOOP=false

# ---------------------------------------------------------------------------
# Crowd Stability Index
# ---------------------------------------------------------------------------
# Whether crowd analysis, the Crowd Stability Index and the Evidence Engine run.
# Independent of the perception pipeline, so detections can be observed without
# an assessment layered on them.
SURGEGUARD_CSI_ENABLED=true

# Indicator weights. 16:142-168 requires these to be configurable per deployment
# rather than hardcoded. They MUST sum to 1.0 - the application refuses to start
# otherwise, rather than silently rescaling the whole index. Defaults are the
# specification frozen in 02_Hackathon_Execution_Plan.md section 4.
SURGEGUARD_CSI_WEIGHT_DENSITY=0.35
SURGEGUARD_CSI_WEIGHT_MOTION=0.20
SURGEGUARD_CSI_WEIGHT_EGRESS=0.20
SURGEGUARD_CSI_WEIGHT_FLOW=0.15
SURGEGUARD_CSI_WEIGHT_RATE=0.10

# Time constant of the moving average applied to the raw index, in seconds.
SURGEGUARD_CSI_SMOOTHING_SECONDS=10.0

# Hysteresis: consecutive windows a band must hold before the Operational Status
# follows it. De-escalation is slower than escalation on purpose - the platform
# should be quicker to warn than to reassure.
SURGEGUARD_CSI_ESCALATE_WINDOWS=3
SURGEGUARD_CSI_DE_ESCALATE_WINDOWS=5

# Uncalibrated density is people per grid cell - a relative scale to tune against
# the actual view (calibrated p/m2 density ignores these). The defaults suit a
# CCTV-style view of a wide space. A camera close to the crowd, such as a phone a
# few metres away, spreads people so thinly over the 6x8 grid that its busiest
# cell rarely holds two; for that view try 3x4 and 1:0,2:45,3:80,4:100.
SURGEGUARD_CROWD_GRID_ROWS=6
SURGEGUARD_CROWD_GRID_COLS=8
# people:pressure knots, ordered by people per cell; linear between, flat outside.
SURGEGUARD_CSI_RELATIVE_DENSITY_KNOTS=1:0,3:50,4.5:80,6:100
# Rise in peak people per cell, per second, at which rate of change is at full pressure.
SURGEGUARD_CSI_RATE_CEILING_RELATIVE=0.05

# ---------------------------------------------------------------------------
# Evidence Engine
# ---------------------------------------------------------------------------
# Observations shown at once. The platform surfaces what needs attention rather
# than everything it can see (03:60-62).
SURGEGUARD_EVIDENCE_MAX_ITEMS=5
# Observations below this confidence are suppressed and counted.
SURGEGUARD_EVIDENCE_MIN_CONFIDENCE=0.25
# Observations retained for the Evidence History.
SURGEGUARD_EVIDENCE_HISTORY_LIMIT=50

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Demonstration scenarios are declared in a manifest, not in code, so adding
# footage is a file change rather than a code change.
# SURGEGUARD_SCENARIO_MANIFEST=../data/scenarios/manifest.yaml
# Crowd Event keyframes. Contains imagery of members of the public: excluded
# from version control and subject to a retention window.
# SURGEGUARD_SNAPSHOT_DIR=../data/snapshots
# The built frontend (`npm run build` in frontend/). Served at / from this same
# origin when it exists; the API, docs and socket are never shadowed by it.
# SURGEGUARD_FRONTEND_DIST_DIR=../frontend/dist
